  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d2354ab56765674ea638b6a813c8e8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroHistoria
  texto: "Eres Monlau, un cavern\xEDcola perdido.\n\nTus amigos salieron de caza sin ti, no sin antes avisarte que estarian en un prado detras de un mamut durmiendo.\n\nYa que se fueron decides hecharte una siesta, al levantar y percatarte que llevan horas perdidos y todavia no han vuelto decides ir en busca de ellos....\n"
  textoContinuar: Haz clic o pulsa una tecla para continuar
  fuente: {fileID: 12800000, guid: bda1dd4c26c4c5a489b481cf770f698f, type: 3}
  "tama\xF1oTexto": 22
  "tama\xF1oContinuar": 13
  colorTexto: {r: 1, g: 1, b: 1, a: 1}
  mostrarSiempre: 0
